# <antiloop deploy root>/wis2node/common.env
#
# Configuration shared by every centre_id deployed on a given host.
# This file is identical across all 3 waloop hosts except for the
# WHOAMI/HOST lines below. It lives in wis2node/ alongside every
# <centre_id>.env, not in a separate directory, because antiloop's
# env loader reads "common.env" and then "<centre_id>.env" both
# relative to the process's working directory (see
# templates/antiloop@.service.j2).
#
# Load order matters: common.env is read first, the per-centre file
# second, so a per-centre file can override anything set here but
# nothing here is centre-specific by design — if a setting ever needs
# to differ per centre, it belongs in <centre_id>.env instead.
#
# This is a template: copy it to shared/common.env (gitignored) and
# fill in your own Redis/MQTT/Traefik details. shared/common.env
# itself is never committed since it carries real credentials.

# Redis Cluster endpoints, as a JSON array of {host,port} objects (not
# a connection string). Points at the standard Redis port on all 3
# waloop hosts. See internal/redisconn for how this is consumed.
REDIS_URL='[{"host":"203.0.113.10","port":6379},{"host":"203.0.113.11","port":6379},{"host":"203.0.113.12","port":6379}]'

# Whether to connect to REDIS_URL as a Redis Cluster (multiple shards,
# cluster-aware routing) or as a single plain Redis instance. true
# builds a cluster client against every entry in REDIS_URL; false
# builds a plain client and requires REDIS_URL to contain exactly one
# {host,port} entry — antiloop refuses to start otherwise. This fleet
# runs a genuine 3-node cluster, so it stays true here.
REDIS_CLUSTER=true

# This host's own identity, used to tag which physical host is
# currently running as primary/secondary for a given centre (written
# into Redis for other tooling to read, e.g. cmd/wis2nodes) and
# included in status/debug log lines. Templated per host via Ansible
# (inventory_hostname resolves to waloop1/waloop2/waloop3), rather
# than left to fall back to the OS hostname, so the value is guaranteed
# correct regardless of how each machine's own hostname happens to be
# configured.
#
# HOST is kept alongside WHOAMI as a fallback for any instance still
# running a binary version that predates the WHOAMI variable — the
# current binary reads WHOAMI first, then HOST, then finally falls
# back to the OS hostname if neither is set. Safe to remove the HOST
# line once every centre has been redeployed at least once on a
# current binary.
WHOAMI={{ inventory_hostname }}
HOST={{ inventory_hostname }}

# WIS2 Global Discovery Catalogue (CSV: metadata_id,topic) and the
# topic-hierarchy hash allowlist (flat list of MD5 hashes) — both are
# small, cheap to fetch, and refreshed periodically per centre_id
# process. See internal/allowlist for how each is parsed and used.
GDC_URL=https://wmo-im.github.io/wis2-guide/gdc-all-channels-latest.txt
TOPIC_URL=https://raw.githubusercontent.com/golfvert/wis2-topic-hierarchy/main/earth-system-discipline-and-below.md5.txt

# JSON Schema documents used to validate inbound WIS2 Notification
# Messages (WNM) and outbound WIS2 Monitoring Event messages (WME).
# See internal/wnm.
SCHEMA_WNM_URL=https://raw.githubusercontent.com/golfvert/wis2-topic-hierarchy/main/wis2-notification-message.json
SCHEMA_WME_URL=https://raw.githubusercontent.com/wmo-im/wis2-monitoring-events/refs/heads/main/schemas/wis2-event-message-bundled.json

# This Global Broker's own outbound MQTT target — every centre on this
# fleet publishes through the same broker with the same credentials.
# Keepalive is given in plain seconds.
MQTT_PUB_BROKER=mqtt://203.0.113.10:1884
MQTT_PUB_USERNAME=changeme
MQTT_PUB_PASSWORD=changeme
MQTT_PUB_KEEPALIVE=300

# This Global Broker's own identity, used as the CloudEvents "source"
# field in the monitor heartbeat and as the report_by label on every
# exported Prometheus metric.
GB_ID=your-global-broker-id

# Whether a message's `properties.content` field is stripped before
# republishing. "discard" strips it; any other value (or unset)
# publishes content unchanged. Set here rather than per-centre since
# nothing observed so far indicates it needs to vary by centre — move
# it to a per-centre env file if that assumption turns out to be
# wrong.
DELETE_CONTENT_OPTION=discard

# Election tick interval and staleness cutoff for the embedded
# primary/secondary election (internal/election) — no external
# election process or binary is used.
ELECTION_INTERVAL=2s
ELECTION_FRESH_WINDOW=8s

# How often the schema documents (SCHEMA_WNM_URL/SCHEMA_WME_URL) and
# the allowlist documents (GDC_URL/TOPIC_URL) are re-fetched from
# their source URLs.
SCHEMA_REFRESH=1h
ALLOWLIST_REFRESH=15m

# Baseline log verbosity. Independent of the -d CLI flag (see
# cmd/antiloop/main.go), which controls per-message/per-category debug
# logging rather than this general level.
LOG_LEVEL=info

# Target size, per Redis pipeline flush, for the dedup layer's batched
# SET NX calls (internal/dedup). Larger batches amortize the Redis
# round-trip cost across more messages at the expense of added
# latency per message while a batch fills.
DEDUP_BATCH_SIZE=200

# How long a batched dedup check waits for more messages to arrive
# before flushing early, even if DEDUP_BATCH_SIZE hasn't been reached.
# Tune this relative to the actual Redis round-trip latency observed
# on the target cluster: too high adds needless per-message delay when
# traffic is light; too low forfeits the batching benefit during a
# genuine burst. Given in a Go duration string (e.g. "300us", "3ms").
DEDUP_BATCH_WAIT=300us

# Whether dedup checks are batched through Redis pipelining at all.
# true (default) batches; false falls back to one direct SET NX call
# per message. Useful for A/B comparing the two paths' latency on a
# given Redis deployment — see internal/dedup and config.Config's
# DedupBatching field.
DEDUP_BATCHING=true

# Directory antiloop writes this centre's Traefik dynamic-configuration
# file into at startup, registering its randomly-assigned metrics
# port. Must already exist and already be watched by Traefik's own
# file-provider configuration on this host. See internal/traefik.
#
# This file is deployed via ansible.builtin.template (see
# deploy_antiloop.yml), so {{ traefik_dir }} below is filled in from
# group_vars/all.yml at deploy time — change the deploy account there,
# not here, to move this.
TRAEFIK_DYNAMIC_DIR={{ traefik_dir }}/dynamic

# Host antiloop tells its local Traefik instance to reach it on, when
# registering its metrics endpoint. Only needed when Traefik runs in a
# bridge-networked Docker container on this same host, where
# "127.0.0.1" (the default, correct for bare-metal/host-networked
# Traefik) resolves to the container's own loopback rather than the
# host's — leave this unset on a host where Traefik runs directly on
# bare metal.
TRAEFIK_BACKEND_HOST=host.docker.internal

# Name of the Traefik entryPoint this centre's router attaches to —
# must match an entryPoint defined in that host's own Traefik static
# configuration (~/traefik/traefik.yml). "web" (plain HTTP, port 80)
# is used here because TLS termination happens once, centrally, at an
# edge Traefik instance on a separate host that fronts all 3 waloop
# hosts and health-checks each centre's primary/secondary status to
# decide which host to route to — see that edge Traefik's own dynamic
# configuration for the other half of this setup. TRAEFIK_TLS below
# must be kept consistent with this choice.
TRAEFIK_ENTRYPOINT=web

# Whether the router antiloop registers with its local Traefik
# includes a TLS termination block. false matches the current
# plain-HTTP-on-:80 topology (TRAEFIK_ENTRYPOINT=web above); set to
# true only for a deployment with no edge proxy in front, paired with
# a TLS-terminating entryPoint name instead.
TRAEFIK_TLS=false
