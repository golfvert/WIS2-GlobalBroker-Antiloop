# wis2node/<centre_id>.env
#
# Per-centre configuration, deployed verbatim to whichever 2 of the 3
# waloop hosts are running this centre (role is elected at runtime by
# the embedded election algorithm, never config). Loaded AFTER
# common.env (see templates/antiloop@.service.j2), so anything set
# here overrides common.env, though nothing here should ever need to
# collide with a common.env key.
#
# This is a template. Real per-centre files (one per WIS2 centre,
# copied to wis2node/<centre_id>.env) are gitignored — each one
# carries that centre's real broker credentials. Copy this file,
# rename it, and fill in the real values to add a centre.

CENTRE_ID=example-centre-id

MQTT_SUB_BROKER=mqtt://broker.example.org:1883
MQTT_SUB_USERNAME=changeme
MQTT_SUB_PASSWORD=changeme
# Comma-separated — subscribes to both the data topic and the monitor
# topic on the same broker. mqttbroker.NewSubscriber subscribes to
# every entry.
MQTT_SUB_TOPIC=origin/a/wis2/example-centre-id/#,monitor/a/wis2/example-centre-id/#

# Per-check policy, confirmed by tracing the actual gating switch nodes
# in the reference Node-RED flow (see config.CheckOption doc comment
# for the full trace):
#   "discard" -> run the check; on failure, drop the message.
#   "verify"  -> run the check; on failure, count it but let it through.
#   anything else (unset, "no", typo, ...) -> check doesn't run at all.
MSG_CHECK_OPTION=discard
TOPIC_CHECK_OPTION=discard
METADATA_CHECK_OPTION=discard
